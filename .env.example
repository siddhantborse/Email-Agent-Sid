# Copy to .env and fill in.

# ---------------------------------------------------------------------------
# Which model does the sorting + checking.  Format: "provider:model"
#
# FREE OPTIONS (no card, no billing account):
#   google_genai:gemini-3.5-flash-lite  <- what the reported numbers use.
#                                      free tier at aistudio.google.com/apikey
#                                      This is Google AI Studio, NOT Google Cloud.
#                                      No billing account, no $30, just a key.
#   ollama:llama3.2                 <- fully local and offline. install ollama,
#                                      then: ollama pull llama3.2
#
# PAID OPTIONS:
#   openai:gpt-4.1-mini
#   anthropic:claude-haiku-4-5-20251001
# ---------------------------------------------------------------------------
SID_MODEL=google_genai:gemini-3.5-flash-lite

GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Ollama needs no key at all.

# Optional: traces every decision so you can see why it chose a lane.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sid-agent

# Your name + a one-line description of what you do.
# The sorter uses this to judge what is relevant to you.
SID_USER_NAME=Sid
SID_USER_CONTEXT=A software engineer. Cares about work threads, interviews, and real people. Not about marketing.

# Domains you actually deal with, comma separated. domains.py escalates
# senders whose domain is close to one of these but not equal to it
# (knowncompany-support.example, knowncompanny.example). Left empty the
# lookalike detector is a no-op, so set it or you lose that defence.
SID_KNOWN_DOMAINS=knowncompany.example
